# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env lên Git.
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
POSTGRES_PASSWORD=assistant
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Tuỳ chọn
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
TIMEZONE=Asia/Ho_Chi_Minh

# Google Calendar (tuỳ chọn, xem README mục "Kết nối Google Calendar")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chạy dev bằng Vite: giữ mặc định. Chạy Docker: đổi 5173 thành 8080.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
FRONTEND_URL=http://localhost:5173
